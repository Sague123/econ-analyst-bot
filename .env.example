# Скопируйте в .env и заполните. .env в репозиторий не коммитится.

# --- общее ---
NODE_ENV=production
LOG_LEVEL=info

# --- база analyst (контейнер analyst-db) ---
# Пароль без спецсимволов URL, например: openssl rand -hex 24
ANALYST_DB_PASSWORD=
# Порт на 127.0.0.1 сервера: для запуска вне compose и для процессов в сети хоста.
ANALYST_DB_PORT=5433
DB_POOL_MAX=5
# Вне compose (npm run migrate, интеграционные тесты) строка задаётся явно:
# DATABASE_URL=postgres://analyst:<пароль>@127.0.0.1:5433/analyst
# TEST_DATABASE_URL=postgres://<админ>:<пароль>@127.0.0.1:<порт>/postgres   # тесты создают и удаляют свою базу

# --- лимиты памяти контейнеров: сервер общий с Velora и Flowscope ---
MEM_ANALYST_DB=512m
MEM_MIGRATE=128m
MEM_COLLECTOR=256m
MEM_ENGINE=384m
MEM_API=256m
MEM_BOT=192m
MEM_CADDY=128m

# --- Caddy (задача 3.8) ---
DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- появятся в своих задачах ---
# FLOWSCOPE_DATABASE_URL=   0.3, роль analyst_ro
# VELORA_DATABASE_URL=      0.3, роль analyst_ro
# BLS_API_KEY=              0.4
# BEA_USER_ID=              0.4
# SEC_USER_AGENT=           0.4, «Компания email»
# ANTHROPIC_API_KEY=        1.7
# LLM_MODEL_FAST=           1.7, ID модели для пересказов
# LLM_MODEL_INSIGHT=        2.5, ID модели для карточек
# TELEGRAM_BOT_TOKEN=       3.4
