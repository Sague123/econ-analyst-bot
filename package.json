{
  "name": "econ-analyst-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "tsx src/main.ts migrate",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
